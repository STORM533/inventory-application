<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Companies | Game Inventory</title>
    <link rel="stylesheet" href="/styles/common.css">
    <link rel="stylesheet" href="/styles/companies.css">
</head>

<body>
    <nav class="navbar">
        <a href="/" class="logo">
            Game Inventory
        </a>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/games">Games</a>
            <a href="/genres">Genres</a>
            <a href="/companies" class="active">Companies</a>
        </div>
        <a href="/games/new" class="add-game-button">
            Add Game
        </a>
    </nav>
    <main class="container">
        <div class="page-heading">
            <h1>Companies</h1>
            <p>Browse games by company.</p>
        </div>
        <div class="company-grid">
            <% companies.forEach(company => { %>
            <a href="/companies/<%= company.id %>" class="company-card">
                <h2><%= company.company %></h2>
                <span class="arrow">→</span>
            </a>
            <% }); %>
        </div>
    </main>
</body>

</html>