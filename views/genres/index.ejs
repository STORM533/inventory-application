<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Genres | Game Inventory</title>
    <link rel="stylesheet" href="/styles/common.css">
    <link rel="stylesheet" href="/styles/genres.css">
</head>

<body>
    <nav class="navbar">
        <a href="/" class="logo">
            Game Inventory
        </a>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/games">Games</a>
            <a href="/genres" class="active">Genres</a>
            <a href="/companies">Companies</a>
        </div>
        <a href="/games/new" class="add-game-button">
            Add Game
        </a>
    </nav>
    <main class="container">
        <div class="page-heading">
            <h1>Genres</h1>
            <p>Browse games by genre.</p>
        </div>
        <div class="genre-grid">
            <% genres.forEach(genre => { %>
            <a href="/genres/<%= genre.id %>" class="genre-card">
                <h2><%= genre.genre %></h2>
                <span class="arrow">→</span>
            </a>
            <% }); %>
        </div>
    </main>
</body>

</html>